# ElectraLearn Backend Configuration
# Copy this to .env and fill in your actual keys

# Google Cloud Project ID
PROJECT_ID=refreshing-gear-495005-s0

# AI Cluster Keys (Comma-separated Gemini API Keys)
# Get from https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_key_1,your_gemini_key_2

# Security
SECRET_KEY=your_production_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1,election-platform-994144605125.us-central1.run.app

# Port (Default: 8000)
PORT=8000
