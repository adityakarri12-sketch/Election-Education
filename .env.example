# ElectraLearn: Environment Variables Example

# API Configuration
PROJECT_NAME="ElectraLearn"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security (Replace with strong random strings in production)
SECRET_KEY="your-secret-key-here"
ALLOWED_HOSTS=["*"]

# External AI Services (Required)
GEMINI_API_KEY="your-gemini-api-key"
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Database (Optional for current modular core)
DATABASE_URL="sqlite:///./sql_app.db"

# Cache Configuration
CACHE_TTL=3600
